import java.util.Random;

/**
 * Representa um carro da corrida. Implementa Runnable para que a logica
 * de corrida possa ser passada a uma Thread.
 */
public class Carro implements Runnable {
    private static final int SLEEP_MIN_MS = 100;
    private static final int SLEEP_MAX_MS = 500;
    private static final int PASSO_MAX_METROS = 50;
    private static final int PIT_STOP_MS = 1500;

    private final String nome;
    private final double distanciaTotalCorrida;
    private double distanciaPercorrida;
    private boolean pitStopFeito;
    private final Podio podio;
    private final Random random = new Random();

    public Carro(String nome, double distanciaTotalCorrida, Podio podio) {
        this.nome = nome;
        this.distanciaTotalCorrida = distanciaTotalCorrida;
        this.distanciaPercorrida = 0;
        this.pitStopFeito = false;
        this.podio = podio;
    }

    @Override
    public void run() {
        while (distanciaPercorrida < distanciaTotalCorrida) {
            double passo = 1 + random.nextInt(PASSO_MAX_METROS);
            distanciaPercorrida += passo;
            if (distanciaPercorrida > distanciaTotalCorrida) {
                distanciaPercorrida = distanciaTotalCorrida;
            }

            System.out.printf("%s andou %.0f metros e ja percorreu %.0f de %.0f metros.%n",
                    nome, passo, distanciaPercorrida, distanciaTotalCorrida);

            // Pit stop uma unica vez, ao passar da metade da prova
            if (!pitStopFeito && distanciaPercorrida >= distanciaTotalCorrida / 2
                    && distanciaPercorrida < distanciaTotalCorrida) {
                pitStopFeito = true;
                System.out.println("[PIT STOP] " + nome + " entrou nos boxes!");
                dormir(PIT_STOP_MS);
                System.out.println("[PIT STOP] " + nome + " voltou para a pista!");
            }

            dormir(SLEEP_MIN_MS + random.nextInt(SLEEP_MAX_MS - SLEEP_MIN_MS + 1));
        }

        int posicao = podio.registrarChegada(nome);
        System.out.println("[CHEGADA] O " + nome + " cruzou a linha de chegada em " + posicao + "o lugar!");
    }

    private void dormir(int ms) {
        try {
            Thread.sleep(ms);
        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
        }
    }

    public String getNome() { return nome; }
    public double getDistanciaPercorrida() { return distanciaPercorrida; }
    public double getDistanciaTotalCorrida() { return distanciaTotalCorrida; }
}
